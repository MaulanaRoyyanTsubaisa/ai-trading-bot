# ==========================================
# AI TRADING SIGNAL BOT & TERMINAL CONFIG
# ==========================================

# 1. Telegram Bot Integration (Dapatkan dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Opsional: AI LLM Key (Kosongkan jika ingin memakai Built-in Hybrid Reasoner)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 3. Parameter Pemindaian Sinyal
